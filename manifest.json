{
  "manifest_version": 2,
  "name": "YoutubeFeedFilter",
  "version": "0.1",

  "description": "Filter your subscriptions feed on Youtube.",

  "icons": {
    "48": "icons/filter-48.png"
  },

  "browser_action": {
    "default_icon": "icons/filter-48.png",
    "default_title": "Options",
    "default_popup": "options.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/feed/subscriptions*"],
      "js": ["feedFilter.js"]
    }
  ]
}
